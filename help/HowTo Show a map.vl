              </p:TypeAnnotation>
            </Pin>
            <Pin Id="Reciwl0Ab4UluhLW4KDMpQ" Name="Input" Kind="InputPin" />
            <Pin Id="JnlOlKNmhwzmPuF1M3M40S" Name="Color" Kind="InputPin" />
            <Pin Id="A5KYqFONkf9icF9wGUmUaQ" Name="Clear" Kind="InputPin" />
            <Pin Id="DoWuP8UbjmW7kLHuQbVa6j" Name="Space" Kind="InputPin" />
            <Pin Id="Tm2TP2v5krGAxyuqGFgyj7" Name="Show Cursor" Kind="InputPin" />
            <Pin Id="Jm6buuU31ClYPmgG8l9bau" Name="VSync" Kind="InputPin" />
            <Pin Id="MnBrkck9uNpOUdyxIS80gE" Name="Enabled" Kind="InputPin" />
            <Pin Id="KECkhqavkjYZP5Ejxz0oCm" Name="Form" Kind="OutputPin" />
            <Pin Id="TFlozXNvUjpC4Hx69bktW9" Name="ClientBounds" Kind="OutputPin" />
            <Pin Id="LZxE38aGvdde0EESeXiuE6" Name="Render Time" Kind="OutputPin" />
          </Node>

        </Canvas>
