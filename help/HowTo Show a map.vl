            <Pin Id="UKsD8aQeDpHBzha5F29gmi" Name="Y" Kind="InputPin" />
            <Pin Id="JG8VQg7xi5Gdx9hNsBy6pQ" Name="Output" Kind="OutputPin" />
          </Node>

          <Node Bounds="60,510,125,19" Id="Khn11vJ4IJAjTvsXxvbB1P">
            <p:NodeReference LastCategoryFullName="Graphics.Skia.Layers" LastDependency="VL.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="ProcessAppFlag" Name="DrawImage" />
              <PinReference Kind="InputPin" Name="Position" />
            </p:NodeReference>
            <Pin Id="CVn4P3RAv7YqBIoJ2QkVpK" Name="Image" Kind="InputPin" />
            <Pin Id="NFQHaS64tHYz9d5wKAmP7g" Name="Position" Kind="InputPin" />
            <Pin Id="J47srTNA7yAJKk7WS2iCiv" Name="Size" Kind="InputPin" />
            <Pin Id="MYZk3cupPnTrMo8b6RkN7n" Name="Size Mode" Kind="InputPin" />
            <Pin Id="IJb0ATfcsEAkANlbLKWcBJ" Name="Anchor" Kind="InputPin" />
            <Pin Id="Vh1KFVWriiQ5tCqXoQhmIi" Name="Output" Kind="OutputPin" />
          </Node>

          <!--
            ClientBounds tells you which space is actually in effect, because it reports in
            that space's own units. With Space = DIPTopLeft expect Pos (0, 0) and a Size equal
            to the view. If it reads Pos (-1.4, -1) and Size (2.8, 2) then the Space value was
            rejected and silently replaced by Normalized, which is what happens to any string
            that is not one of the four members.
          -->
          <Pad Id="P7iXhPmQnV6juUIOXJ6fU1" Comment="ClientBounds" Bounds="380,630,190,44" ShowValueBox="true" isIOBox="true" />

          <!--
            Size Mode and Anchor decide how Position and Size are read, and leaving them at
            their defaults drew nothing at all. "Size" means use the Size input literally;
            "TopLeft" makes Position the top-left corner, which is what TileDestinationParts
            reports. VL.Skia's own pixel-space example sets both explicitly too.
          -->
          <Pad Id="Sy0b0NCKRzQskbBap1RdrL" Comment="Size Mode" Bounds="380,510,90,19" ShowValueBox="true" isIOBox="true" Value="Size">
            <p:TypeAnnotation LastCategoryFullName="Graphics.Skia" LastDependency="VL.Skia.vl">
              <Choice Kind="TypeFlag" Name="SizeMode" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="JW1zjVDNDumtnYWccYUOHw" Comment="Anchor" Bounds="490,510,90,19" ShowValueBox="true" isIOBox="true" Value="TopLeft">
            <p:TypeAnnotation LastCategoryFullName="2D" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="RectangleAnchor" />
            </p:TypeAnnotation>
          </Pad>
          <Pad Id="FNeWLpu61a4pGYPRLHbeqQ" Comment="Background" Bounds="380,590,143,20" ShowValueBox="true" isIOBox="true" Value="0.15, 0.35, 0.55, 1">
            <p:TypeAnnotation LastCategoryFullName="Color" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="RGBA" />
            </p:TypeAnnotation>
          </Pad>


          <Node Bounds="60,620,165,19" Id="LlxBBnuGnVhLBnCi4g11xh">
