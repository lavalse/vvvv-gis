  <Patch Id="R3fmJmSliSZTVVxdUMSt9a">
    <Canvas Id="J7EtYdHmo2xCfl1zJDU1fn" DefaultCategory="Main" CanvasType="FullCategory" />
    <Node Name="Application" Bounds="100,100" Id="MrzKHC9OXd37SVFLANoUnR">
      <p:NodeReference>
        <Choice Kind="ContainerDefinition" Name="Process" />
