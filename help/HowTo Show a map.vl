          </Node>

          <Node Bounds="60,300,140,19" Id="RyOaNNTvdoVBy2NxXuvvJX">
            <p:NodeReference LastCategoryFullName="GIS.Skia.Tiles" LastDependency="VL.GIS.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="TileDestinationParts" />
            </p:NodeReference>
            <Pin Id="Eo0CWwtz9wnakgd4dcYFrb" Name="View" Kind="InputPin" />
            <Pin Id="UwbQZOy6LydKsCMDeZmAs4" Name="Tile Index" Kind="InputPin" />
            <Pin Id="Pm1sbWUWMQdpzYr4VtnVDq" Name="X" Kind="OutputPin" />
            <Pin Id="HFjJvrTcmAkpNalopG4Ldf" Name="Y" Kind="OutputPin" />
            <Pin Id="EejwYBD2TPwN8ozUyBmOr0" Name="Width" Kind="OutputPin" />
            <Pin Id="PkyAFgJyQ7aDFd46M9BfcE" Name="Height" Kind="OutputPin" />
          </Node>

          <!--
            The four numbers on show, because when nothing appears the first question is
            whether the arithmetic or the coordinate space is at fault, and these separate
            them. For the values above expect roughly 278, 61, 256, 256.
          -->
          <Pad Id="QkRg8EGgaEkth5O9GlK9YN" Comment="X" Bounds="60,340,70,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="HQ6UUTTXrbsteIImpBkGqe" Comment="Y" Bounds="140,340,70,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="HJZkOWx7Bf9bVgutie3dKC" Comment="Width px" Bounds="220,340,70,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="S4qGKR99IcdxOuDSjKRuNa" Comment="Height px" Bounds="300,340,70,15" ShowValueBox="true" isIOBox="true" />

          <!--
            The step that was missing every time this patch failed to draw.

            VL.Skia does not draw in pixels. Its default space is about 2.8 by 2 units wide, so
            handing DrawImage a position of 278 puts the tile a hundred times further out than
            the whole window is wide: off screen, with nothing drawn and no error. The Space
            pin on the Renderer is meant to change that, but an unrecognised value is silently
            replaced by the default, so relying on it means relying on something that fails
            quietly. Converting here does not.

            Space Height is left unconnected: its default of 2 is the height of VL.Skia's
            default space. Read the Renderer's ClientBounds below to confirm that.
          -->
          <Node Bounds="60,370,145,19" Id="S7NUdha4NOdYgyQMBENHbJ">
            <p:NodeReference LastCategoryFullName="GIS.Skia.Viewport" LastDependency="VL.GIS.Skia.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="ToRendererSpace" />
            </p:NodeReference>
            <Pin Id="EbiWtkRDd1ar8XZLdXij0W" Name="View" Kind="InputPin" />
            <Pin Id="FOW5pXqpNCW9flIIYGQ9ZV" Name="Pixel X" Kind="InputPin" />
            <Pin Id="RjUHb9pGzF2fjbNCsObMSK" Name="Pixel Y" Kind="InputPin" />
            <Pin Id="BXyVMpYKX8GaWPe2OymhqB" Name="Pixel Width" Kind="InputPin" />
            <Pin Id="Lmkq9SzXhDORcBYnkYPr2r" Name="Pixel Height" Kind="InputPin" />
            <Pin Id="JH97SZTQ06adQDMbHYBeVN" Name="X" Kind="OutputPin" />
            <Pin Id="MeEiyg7asDNVPjlYn6Kr4y" Name="Y" Kind="OutputPin" />
            <Pin Id="JiKmgYh8mWrOo2vCuqTRif" Name="Width" Kind="OutputPin" />
            <Pin Id="G3Wc5i8y1NBs7zqTgNRARG" Name="Height" Kind="OutputPin" />
          </Node>

          <!--
            The same rectangle in the units the renderer actually uses. Expect roughly
            -0.43, -0.80, 0.85, 0.85, all well inside the 2.8 by 2 space, which the pixel
            figures above were not.
          -->
          <Pad Id="BAAVpGXklnhto0Q981SccJ" Comment="X units" Bounds="60,400,70,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="HFQiIIs2ahsNwZNftSTjfz" Comment="Y units" Bounds="140,400,70,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="PI1UukvOx29s2vqlKAolCf" Comment="Width units" Bounds="220,400,70,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="O5pqHgPYI8klSmTmAnOHPz" Comment="Height units" Bounds="300,400,70,15" ShowValueBox="true" isIOBox="true" />

          <Node Bounds="60,430,90,19" Id="LVZ2tCRxP2sbBLCYS5HHsu">
            <p:NodeReference LastCategoryFullName="2D.Vector2" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Vector (Join)" />
              <CategoryReference Kind="Vector2Type" Name="Vector2" NeedsToBeDirectParent="true" />
            </p:NodeReference>
            <Pin Id="E7vvmWf7hpR80XfRBSILEi" Name="X" Kind="InputPin" />
            <Pin Id="FLpdLnUkKXROBLMBgNmsDr" Name="Y" Kind="InputPin" />
            <Pin Id="Oo4L31kjDDnsAey0x8FAwV" Name="Output" Kind="OutputPin" />
          </Node>

          <Node Bounds="170,430,90,19" Id="VYFLpNKZ01nXCSZ9gvVAEl">
            <p:NodeReference LastCategoryFullName="2D.Vector2" LastDependency="VL.CoreLib.vl">
              <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
              <Choice Kind="OperationCallFlag" Name="Vector (Join)" />
              <CategoryReference Kind="Vector2Type" Name="Vector2" NeedsToBeDirectParent="true" />
            </p:NodeReference>
