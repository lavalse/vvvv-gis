<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>VL.GIS.Tiles</AssemblyName>
    <RootNamespace>VL.GIS.Tiles</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>VL.GIS Contributors</Authors>
    <Description>Map tile fetching nodes for vvvv gamma (OSM, XYZ)</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- See src\VL.GIS.Core\VL.GIS.Core.csproj for why this is here and not in the nuspec. -->
    <PackageReference Include="VL.Core" Version="2025.7.2" />

    <!-- BruTile was here. Removing it is what lets VL.GIS and VL.Mapsui be installed together:
         Mapsui.Tiling pins BruTile to 5.x, we were on 6, and vvvv's package folder is flat.
         Everything it gave us is now in TileTypes.cs. See docs/DESIGN.md. -->
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VL.GIS.Core\VL.GIS.Core.csproj" />
  </ItemGroup>

</Project>
