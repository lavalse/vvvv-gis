<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>VL.GIS.Core</AssemblyName>
    <!--
      Deliberately not VL.GIS.Core. The VL node category is derived from the namespace
      (minus the "VL" prefix, see AssemblyInfo.cs), so VL.GIS keeps categories at
      GIS.Geometry rather than GIS.Core.Geometry. The assembly name is unrelated to it.
    -->
    <RootNamespace>VL.GIS</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>VL.GIS Contributors</Authors>
    <Description>Core GIS geometry and projection nodes for vvvv gamma</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuspecFile>..\..\VL.GIS.nuspec</NuspecFile>
    <NuspecBasePath>..\..\</NuspecBasePath>
  </PropertyGroup>

  <ItemGroup>
    <!--
      VL.Core supplies the [ImportAsIs] attribute (see AssemblyInfo.cs). Without it the
      assembly's public statics are only reachable as raw .NET reflection nodes, hidden
      behind the NodeBrowser's dependency toggle, instead of appearing as normal nodes.

      Not declared in VL.GIS.nuspec on purpose: VL.Core ships with vvvv, so it is always
      present at runtime. Same as VL.Devices.RealSense / VL.OpenCV.

      2025.7.2 is the floor, not a preference: [Name] and [SkipCategory] were added in
      gamma 7.2, which makes 7.2 the minimum vvvv version for VL.GIS. The alternative
      (renaming the C# classes instead of just their VL-facing names) would keep 7.0
      working but force an alias on NetTopologySuite's Geometry through every signature
      that returns one.
    -->
    <PackageReference Include="VL.Core" Version="2025.7.2" />

    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="3.0.0" />
    <PackageReference Include="ProjNet" Version="2.1.0" />
  </ItemGroup>

</Project>
